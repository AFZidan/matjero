APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://commerce:commerce@localhost:5432/commerce?sslmode=disable
REDIS_ADDR=localhost:6379
RABBITMQ_URL=amqp://commerce:commerce@localhost:5672/
ZITADEL_ISSUER=http://localhost:8081
SHUTDOWN_TIMEOUT_SECONDS=10

# Server-side HMAC-SHA256 signing key for short-lived, store-scoped theme draft
# preview tokens. Required by seller-api for POST /v1/seller/stores/{id}/theme/preview.
# Generate with: openssl rand -base64 48
# Must be at least 32 bytes and identical across every seller-api replica, otherwise
# tokens issued by one instance will not verify on another. Rotating it invalidates
# all outstanding preview tokens (they are short-lived, so this is safe).
# When unset, preview endpoints fail closed with 503 rather than issuing unsigned tokens.
THEME_PREVIEW_SECRET=

# Core internal API service credentials (ADR-017).
#
# Each actor service presents its own bearer token together with
# X-Matjero-Service: seller|admin|supplier. A token is bound to the caller that
# names it: a valid seller token presented as "admin" is rejected.
#
# core-api refuses to start when none of these are set, so a misconfigured
# deployment fails closed instead of serving business data anonymously.
#
# Generate each with: openssl rand -base64 48
#
# These are secrets. Never commit a real value, never log one, and never bake one
# into an image layer. In production they are injected by the orchestrator's
# secret store.
CORE_INTERNAL_SELLER_TOKEN=
CORE_INTERNAL_ADMIN_TOKEN=
CORE_INTERNAL_SUPPLIER_TOKEN=
