                              "status",
                              "symbol"
                            ],
                            "type": "object"
                          },
                          "default_locale": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "supported_locales": {
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          },
                          "timezone": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "code",
                          "configuration",
                          "country",
                          "currency",
                          "default_locale",
                          "status",
                          "supported_locales",
                          "timezone"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "markets"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Market collection"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
