{
  "components": {},
  "info": {
    "description": "OpenAPI contract for the public Matjero Storefront API.",
    "title": "Matjero Storefront API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/bootstrap": {
      "get": {
        "description": "Returns the app identity, localization context, authenticated principal when present, and market list.",
        "operationId": "getBootstrap",
        "parameters": [
          {
            "description": "Override locale resolution",
            "in": "query",
            "name": "locale",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "actor": {
                      "type": "string"
                    },
                    "app": {
                      "type": "string"
                    },
                    "direction": {
                      "type": "string"
                    },
                    "locale": {
                      "type": "string"
                    },
                    "markets": {
                      "items": {
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "configuration": {
                            "additionalProperties": true,
                            "type": "object"
                          },
                          "country": {
                            "properties": {
                              "code": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "status": {
                                "type": "string"
                              },
                              "timezone": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "code",
                              "name",
                              "status",
                              "timezone"
                            ],
                            "type": "object"
                          },
                          "currency": {
                            "properties": {
                              "code": {
                                "type": "string"
                              },
                              "minor_unit": {
                                "format": "int32",
                                "type": "integer"
                              },
                              "status": {
                                "type": "string"
                              },
                              "symbol": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "code",
                              "minor_unit",
                              "status",
                              "symbol"
                            ],
                            "type": "object"
                          },
                          "default_locale": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "supported_locales": {
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          },
                          "timezone": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "code",
                          "configuration",
                          "country",
                          "currency",
                          "default_locale",
                          "status",
                          "supported_locales",
                          "timezone"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "principal": {
                      "nullable": true,
                      "properties": {
                        "audience": {
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        },
                        "claims": {
                          "additionalProperties": true,
                          "type": "object"
                        },
                        "email": {
                          "type": "string"
                        },
                        "expires_at": {
                          "format": "date-time",
                          "type": "string"
                        },
                        "issued_at": {
                          "format": "date-time",
                          "type": "string"
                        },
                        "issuer": {
                          "type": "string"
                        },
                        "locale": {
                          "type": "string"
                        },
                        "preferred_username": {
                          "type": "string"
                        },
                        "roles": {
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        },
                        "subject": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "audience",
                        "expires_at",
                        "issued_at",
                        "issuer",
                        "roles",
                        "subject"
                      ],
                      "type": "object"
                    },
                    "supported_locales": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "actor",
                    "app",
                    "direction",
                    "locale",
                    "markets",
                    "supported_locales"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Bootstrap payload"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Forbidden"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Internal error"
          }
        },
        "summary": "Load app bootstrap data",
        "tags": [
          "Identity \u0026 Access",
          "Markets"
        ]
      }
    },
    "/v1/markets": {
