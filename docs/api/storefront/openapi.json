                    "status": {
                      "type": "string"
                    },
                    "supported_locales": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "timezone": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "configuration",
                    "country",
                    "currency",
                    "default_locale",
                    "status",
                    "supported_locales",
                    "timezone"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Market"
